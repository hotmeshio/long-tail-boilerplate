# Long Tail boilerplate environment. Copy to .env (gitignored): cp .env.example .env
#
# Under `docker compose up`, the app container reads this file, and compose
# overrides the values that differ inside the network (POSTGRES_HOST=postgres,
# NATS_URL=nats://nats:4222, LT_S3_ENDPOINT=http://minio:9000, ...). The values
# below are the ones a process on your machine uses (npm run dev, scripts).

# ── Local stack ports (docker compose) ─────────────────────────────────────
# Change a host port when another stack already holds it. The app always
# listens on 3030 inside its container.
# PG_PORT=5416
# NATS_PORT=4222
# NATS_WS_PORT=9222
# MINIO_PORT=9002
# MINIO_CONSOLE_PORT=9003

# ── Database (required) ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5416
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=myapp

# External postgres (e.g. another project's). Host processes use POSTGRES_*;
# the app container uses DOCKER_POSTGRES_* (defaults: postgres:5432 in compose).
# POSTGRES_PORT=5433
# DOCKER_POSTGRES_HOST=host.docker.internal
# DOCKER_POSTGRES_PORT=5433
# POSTGRES_DB=acme_workflow

# ── Server and sign-in ─────────────────────────────────────────────────────
# Dashboard port. Under docker compose it is the host port; the container listens on 3030.
# Change LT_OAUTH_ISSUER below to match, or MCP sign-in will point at the old port.
PORT=3030
JWT_SECRET=change-me-in-production
# First-boot superadmin password (login: superadmin). Seeds only when set.
SEED_ADMIN_PASSWORD=l0ngt@1l
# Split one process into roles: api (dashboard, REST, MCP) or worker. Unset runs both.
# APP_ROLE=

# OAuth sign-in for MCP clients at /mcp. The public base URL; unset disables OAuth.
LT_OAUTH_ISSUER=http://localhost:3030
# Comma-separated https redirect URIs allowed beyond loopback (e.g. a hosted MCP client)
# LT_OAUTH_ALLOWED_REDIRECT_URIS=
# Spent codes/tokens, revoked or unused grants, and never-consented clients are pruned
# once dead this many days; each process sweeps at most every OAUTH_SWEEP_SECONDS.
# OAUTH_RETENTION_DAYS=7
# OAUTH_SWEEP_SECONDS=600

# ── Event bus (NATS) ───────────────────────────────────────────────────────
# The dashboard's live updates. The browser connects through the app at /nats-ws.
NATS_URL=nats://localhost:4222
NATS_TOKEN=dev_api_secret
NATS_WS_TARGET=ws://localhost:9222

# ── File storage: MinIO locally (S3-compatible), S3 on AWS ─────────────────
LT_STORAGE_BACKEND=s3
LT_S3_BUCKET=long-tail-files
LT_S3_ENDPOINT=http://localhost:9002
LT_S3_REGION=us-east-1
LT_S3_ACCESS_KEY=minioadmin
LT_S3_SECRET_KEY=minioadmin
LT_S3_FORCE_PATH_STYLE=true

# ── LLM (optional) ─────────────────────────────────────────────────────────
# Enables the workflow builder, MCP tool orchestration, and screenshot vision.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Third-party sign-in for workflows (optional) ───────────────────────────
# OAUTH_ENCRYPTION_KEY=...
# OAUTH_GOOGLE_CLIENT_ID=...
# OAUTH_GOOGLE_CLIENT_SECRET=...

# ── Example integrations (optional) ────────────────────────────────────────
# bambu-farm: POST printer events here; log-only when unset.
# BAMBU_WEBHOOK_URL=
# BAMBU_WEBHOOK_SECRET=

# ── Tests ──────────────────────────────────────────────────────────────────
# Skip the LLM-driven self-test (tests/integration/self-test.test.ts). With an LLM
# key set, it builds tools live and can fail on non-deterministic output; CI skips it.
# SKIP_LLM_SELF_TEST=1

# Target for `npm run *:remote:*` scripts (they set REMOTE=1). Keep the real URL
# here, never in the repo.
# LT_REMOTE_URL=https://app.example.com
# REMOTE_PASSWORD=

# ── AWS deploy (deploy/cdk) ────────────────────────────────────────────────
# CDK does not read this file. Export these in your shell before any cdk command;
# CI reads them from repository secrets. See deploy/README.md.
# export LT_HOSTED_ZONE_DOMAIN=example.com
# export LT_SUBDOMAIN=app
